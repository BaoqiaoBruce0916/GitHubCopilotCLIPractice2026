---
/**
 * Renders the static game catalog and its client-side filtering controls.
 * The page loads catalog data at build time and filters rendered cards in the browser.
 */

import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form
        class="mb-6 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg"
        data-testid="game-filters"
      >
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <fieldset data-testid="category-filters">
            <legend class="mb-3 text-sm font-semibold text-slate-100">Categories</legend>
            <div class="flex flex-wrap gap-x-4 gap-y-3">
              {categories.map((category) => (
                <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-300">
                  <input
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    type="checkbox"
                    name="category"
                    value={category.id}
                    data-testid={`category-filter-${category.id}`}
                  />
                  {category.name}
                </label>
              ))}
            </div>
          </fieldset>

          <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
            <label class="flex flex-col gap-2 text-sm font-semibold text-slate-100" for="publisher-filter">
              Publisher
              <select
                id="publisher-filter"
                name="publisher"
                class="min-w-52 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </label>
            <button
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              type="reset"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>
        </div>
      </form>

      <p
        class="mb-4 text-sm text-slate-300"
        role="status"
        aria-live="polite"
        data-testid="filter-results-status"
      >
        Showing {games.length} of {games.length} games.
      </p>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div
            hidden
            data-testid="no-results"
            class="mt-6 rounded-xl border border-slate-700 bg-slate-800/50 py-12 text-center backdrop-blur-sm"
          >
            <p class="text-slate-300">No games match the selected filters.</p>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const resultsStatus = document.querySelector<HTMLElement>('[data-testid="filter-results-status"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-results"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  if (filterForm && publisherFilter && clearFiltersButton && resultsStatus && noResults) {
    const applyFilters = (): void => {
      const selectedCategoryIds = new Set(
        Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
          .map((input) => input.value),
      );
      const publisherId = publisherFilter.value;
      let visibleGames = 0;

      for (const card of gameCards) {
        const matchesCategory =
          selectedCategoryIds.size === 0 || selectedCategoryIds.has(card.dataset.categoryId ?? '');
        const matchesPublisher = publisherId === '' || card.dataset.publisherId === publisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleGames++;
        }
      }

      noResults.hidden = visibleGames !== 0;
      resultsStatus.textContent = `Showing ${visibleGames} of ${gameCards.length} games.`;
    };

    filterForm.addEventListener('change', applyFilters);
    clearFiltersButton.addEventListener('click', () => {
      filterForm
        .querySelectorAll<HTMLInputElement>('input[name="category"]')
        .forEach((input) => {
          input.checked = false;
        });
      publisherFilter.value = '';
      applyFilters();
    });
  }
</script>
